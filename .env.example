# Dashboard (Next.js). Lokal als .env.local anlegen, auf Vercel in den Projekteinstellungen setzen.
# Der Service-Role-Key wird nur serverseitig benutzt (Server-Komponenten und Server Actions).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Zugriffsschutz für /arbitrage (HTTP Basic Auth). Ohne Passwort ist der Bereich in Produktion gesperrt.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=bitte-ein-langes-passwort
