# ---- Persistenz ----
# supabase (Betrieb) oder memory (Demo/Tests ohne Datenbank)
STORE=supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # nur im Worker und auf dem Server, nie im Browser

# ---- Märkte ----
# ccxt = echte Börsen (nur öffentliche Marktdaten, kein Key nötig), mock = synthetische Preise, listings = Inserate aus der DB
ADAPTERS=ccxt,listings
EXCHANGES=kraken,bitstamp,coinbase,bitvavo
SYMBOLS=BTC/EUR,ETH/EUR
POLL_INTERVAL_MS=2000
RECORD_TICKS=false

# ---- Engine ----
TRADE_SIZE_QUOTE=500        # Einsatz pro Deal in Quote-Währung (EUR)
MIN_NET_SPREAD_BPS=10       # ab hier wird eine Gelegenheit gespeichert
AUTO_PAPER_BPS=30           # ab hier automatisch Paper-Deal, 0 = nie
OPPORTUNITY_TTL_MS=15000
SLIPPAGE_BPS=5              # Sicherheitsaufschlag pro Seite
TRANSFER_MODEL=prefunded    # prefunded (Bestand auf beiden Seiten) oder withdraw (Abhebegebühr einrechnen)
EXECUTION_MODE=paper        # nur paper ist implementiert
TRIANGULAR=true             # Dreiecks-Arbitrage innerhalb einer Börse (EUR→BTC→ETH→EUR)
TRIANGLE_START=             # Startwährung, leer = Quote-Währung des ersten Symbols (EUR)

# ---- Spread-Historie ----
SPREAD_SAMPLE_INTERVAL_MS=60000   # jede Route alle 60 s in spread_samples schreiben, 0 = aus
SPREAD_HISTORY_DAYS=14            # ältere Messpunkte löschen

# ---- Nachrichten ----
MAILER=console              # console | smtp | resend
MAIL_FROM="Signal Arbitrage <bot@deine-domain.de>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Posteingang (Antworten zuordnen). Leer lassen = aus.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
INBOX_POLL_MS=60000

# ---- Sonstiges ----
WORKER_ID=worker-1
LOG_LEVEL=info
MOCK_MARKETS=3
MOCK_SEED=42
# Für späteren Echthandel: <BÖRSE>_API_KEY / <BÖRSE>_SECRET, z. B. KRAKEN_API_KEY
